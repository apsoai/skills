{
  "version": 2, "rootFolder": "src", "apiType": "Rest",
  "entities": [
    { "name": "Organization", "created_at": true, "updated_at": true, "fields": [{ "name": "name", "type": "text" }] },
    { "name": "User", "created_at": true, "updated_at": true, "scopeBy": "organizationId",
      "fields": [{ "name": "name", "type": "text" }, { "name": "email", "type": "text" }],
      "uniques": [{ "fields": ["organizationId", "email"] }] },
    { "name": "Project", "created_at": true, "updated_at": true, "scopeBy": "organizationId",
      "fields": [{ "name": "name", "type": "text" }] },
    { "name": "Task", "created_at": true, "updated_at": true, "scopeBy": "organizationId",
      "fields": [
        { "name": "title", "type": "text" },
        { "name": "status", "type": "enum", "values": ["todo", "in_progress", "done"], "default": "todo" }
      ],
      "indexes": [{ "fields": ["projectId", "status"] }, { "fields": ["assigneeId", "status"] }] },
    { "name": "TimeEntry", "created_at": true, "updated_at": true, "scopeBy": "organizationId",
      "fields": [{ "name": "hours", "type": "decimal", "precision": 6, "scale": 2 }] },
    { "name": "Comment", "created_at": true, "updated_at": true, "scopeBy": "organizationId",
      "fields": [{ "name": "body", "type": "text" }] }
  ],
  "relationships": [
    { "from": "User", "to": "Organization", "type": "ManyToOne" },
    { "from": "Project", "to": "Organization", "type": "ManyToOne", "index": true },
    { "from": "Task", "to": "Organization", "type": "ManyToOne", "index": true },
    { "from": "Task", "to": "Project", "type": "ManyToOne", "cascadeDelete": true },
    { "from": "Task", "to": "User", "type": "ManyToOne", "to_name": "assignee", "nullable": true },
    { "from": "TimeEntry", "to": "Organization", "type": "ManyToOne", "index": true },
    { "from": "TimeEntry", "to": "Project", "type": "ManyToOne", "index": true, "cascadeDelete": true },
    { "from": "Comment", "to": "Organization", "type": "ManyToOne", "index": true },
    { "from": "Comment", "to": "Project", "type": "ManyToOne", "index": true, "cascadeDelete": true }
  ]
}
